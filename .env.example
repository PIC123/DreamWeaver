# Supabase (public — safe to ship to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here

# Supabase (server-only — used by Route Handlers for cascade deletes etc.)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# OpenAI (server-only — NEVER prefix with NEXT_PUBLIC_)
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_IMAGE_MODEL=dall-e-3

# ElevenLabs (server-only, optional)
ELEVENLABS_API_KEY=

# Optional: rate-limit / abuse mitigation
ALLOWED_IMAGE_HOST=oaidalleapiprodscus.blob.core.windows.net
