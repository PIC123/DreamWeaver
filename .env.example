# ── Supabase ─────────────────────────────────────────────────────────────────
# Project Settings → API. These two are safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Server only. Never prefix with NEXT_PUBLIC_. (SUPABASE_SECRET_KEY also works.)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── OpenAI ───────────────────────────────────────────────────────────────────
# Server only.
OPENAI_API_KEY=sk-your-key

# Optional overrides (defaults shown).
# OPENAI_TEXT_MODEL=gpt-6-luna
# OPENAI_TEXT_REASONING_EFFORT=low        # or "default" to send nothing
# OPENAI_IMAGE_MODEL=gpt-image-2.6-flare
# OPENAI_IMAGE_QUALITY=low                # low | medium | high
# OPENAI_IMAGE_SIZE=1024x1024
# MODERATION=on                           # "off" skips the free moderation check

# ── Daily budgets (rolling 24 hours; one turn = one scene + one picture) ─────
# QUOTA_GUEST_TURNS_PER_DAY=25
# QUOTA_MEMBER_TURNS_PER_DAY=150
# QUOTA_GLOBAL_TURNS_PER_DAY=1500
# QUOTA_SETTINGS_PER_DAY=40
# QUOTA_GLOBAL_SETTINGS_PER_DAY=3000
# QUOTA_GUEST_PORTRAIT_ROUNDS_PER_DAY=3     # character creator: one round = 3 portraits
# QUOTA_MEMBER_PORTRAIT_ROUNDS_PER_DAY=10
# QUOTA_GLOBAL_PORTRAIT_ROUNDS_PER_DAY=300
